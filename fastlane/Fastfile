# Build To-Do and upload it to TestFlight, using the same GitHub secrets as
# the Loop/Trio Browser Build (TEAMID, GH_PAT, FASTLANE_KEY_ID,
# FASTLANE_ISSUER_ID, FASTLANE_KEY, MATCH_PASSWORD).

default_platform(:ios)

TEAMID = ENV["TEAMID"]
GH_PAT = ENV["GH_PAT"]
GITHUB_WORKSPACE = ENV["GITHUB_WORKSPACE"]
GITHUB_REPOSITORY_OWNER = ENV["GITHUB_REPOSITORY_OWNER"]
FASTLANE_KEY_ID = ENV["FASTLANE_KEY_ID"]
FASTLANE_ISSUER_ID = ENV["FASTLANE_ISSUER_ID"]
FASTLANE_KEY = ENV["FASTLANE_KEY"]
MS_CLIENT_ID = ENV["MS_CLIENT_ID"].to_s
ENV["FASTLANE_XCODEBUILD_SETTINGS_TIMEOUT"] = "120"

BUNDLE_ID = "com.#{TEAMID}.todo"
ICLOUD_CONTAINER = "iCloud.#{BUNDLE_ID}"
PROJECT = "#{GITHUB_WORKSPACE}/ToDo.xcodeproj"

def api_key!
  app_store_connect_api_key(
    key_id: FASTLANE_KEY_ID,
    issuer_id: FASTLANE_ISSUER_ID,
    key_content: FASTLANE_KEY
  )
end

def match_auth
  Base64.strict_encode64("#{GITHUB_REPOSITORY_OWNER}:#{GH_PAT}")
end

platform :ios do
  desc "Register the bundle ID with iCloud and push capabilities, and (re)create its App Store profile"
  lane :identifiers do
    setup_ci if ENV["CI"]
    api_key!

    bundle = Spaceship::ConnectAPI::BundleId.find(BUNDLE_ID) ||
      Spaceship::ConnectAPI::BundleId.create(name: "To-Do", identifier: BUNDLE_ID, platform: "IOS")
    UI.success("Bundle ID ready: #{bundle.identifier}")

    types = Spaceship::ConnectAPI::BundleIdCapability::Type
    existing = bundle.get_capabilities.map(&:capability_type)

    unless existing.include?(types::PUSH_NOTIFICATIONS)
      bundle.create_capability(types::PUSH_NOTIFICATIONS)
      UI.success("Enabled Push Notifications")
    end

    unless existing.include?(types::ICLOUD)
      begin
        bundle.create_capability(
          types::ICLOUD,
          settings: [{
            key: Spaceship::ConnectAPI::BundleIdCapability::Settings::ICLOUD_VERSION,
            options: [{ key: Spaceship::ConnectAPI::BundleIdCapability::Options::XCODE_6 }]
          }]
        )
        UI.success("Enabled iCloud")
      rescue => e
        UI.important("Couldn't enable iCloud automatically (#{e.message}). Turn it on for #{BUNDLE_ID} at developer.apple.com.")
      end
    end

    # Always regenerate, so the profile picks up the iCloud container once
    # it's assigned to the App ID.
    match(
      type: "appstore",
      readonly: false,
      force: true,
      git_basic_authorization: match_auth,
      app_identifier: [BUNDLE_ID]
    )
  end

  desc "Build a signed IPA"
  lane :build_app_ipa do
    setup_ci if ENV["CI"]
    key = api_key!

    update_project_team(path: PROJECT, teamid: TEAMID)

    previous = latest_testflight_build_number(app_identifier: BUNDLE_ID, api_key: key, initial_build_number: 0)
    increment_build_number(xcodeproj: PROJECT, build_number: previous + 1)

    match(
      type: "appstore",
      readonly: true,
      git_basic_authorization: match_auth,
      app_identifier: [BUNDLE_ID]
    )
    profile = Actions.lane_context[SharedValues::MATCH_PROVISIONING_PROFILE_MAPPING][BUNDLE_ID]

    update_code_signing_settings(
      path: PROJECT,
      use_automatic_signing: false,
      team_id: TEAMID,
      bundle_identifier: BUNDLE_ID,
      profile_name: profile,
      code_sign_identity: "iPhone Distribution",
      targets: ["ToDo"]
    )

    gym(
      project: PROJECT,
      scheme: "ToDo",
      configuration: "Release",
      export_method: "app-store",
      export_options: { provisioningProfiles: { BUNDLE_ID => profile } },
      xcargs: "MS_CLIENT_ID='#{MS_CLIENT_ID}'",
      output_name: "ToDo.ipa",
      destination: "generic/platform=iOS",
      buildlog_path: "buildlog"
    )
  end

  desc "Upload to TestFlight"
  lane :release do
    upload_to_testflight(
      api_key: api_key!,
      ipa: "ToDo.ipa",
      skip_waiting_for_build_processing: true,
      changelog: "Built from commit #{last_git_commit[:abbreviated_commit_hash]}"
    )
  end
end
